<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_gradient"
    tools:context=".PhotoScrollActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="#002038"
        android:title="Photo Scroll"
        android:titleTextColor="?attr/colorOnPrimary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:titleCentered="true" />

    <ImageView
        android:id="@+id/viewPhoto"
        android:layout_width="376dp"
        android:layout_height="351dp"
        android:src="@android:drawable/gallery_thumb"
        app:layout_constraintBottom_toTopOf="@+id/backButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topAppBar"
        app:layout_constraintVertical_bias="0.211" />

    <ImageButton
        android:id="@+id/backPhoto"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginStart="60dp"
        android:layout_marginTop="24dp"
        android:adjustViewBounds="true"
        android:background="@drawable/circular_background"
        android:contentDescription="Previous"
        android:elevation="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_arrow_left"
        app:layout_constraintBottom_toTopOf="@+id/backButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/viewPhoto"
        app:layout_constraintVertical_bias="0.24" />

    <TextView
        android:id="@+id/backLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Previous"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@+id/backPhoto"
        app:layout_constraintStart_toStartOf="@+id/backPhoto"
        app:layout_constraintEnd_toEndOf="@+id/backPhoto"
        android:layout_marginTop="4dp"/>

    <ImageButton
        android:id="@+id/nextPhoto"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="60dp"
        android:adjustViewBounds="true"
        android:background="@drawable/circular_background"
        android:contentDescription="Next"
        android:elevation="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_arrow_right"
        app:layout_constraintBottom_toTopOf="@+id/backButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/viewPhoto"
        app:layout_constraintVertical_bias="0.241" />

    <TextView
        android:id="@+id/nextLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Next"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@+id/nextPhoto"
        app:layout_constraintStart_toStartOf="@+id/nextPhoto"
        app:layout_constraintEnd_toEndOf="@+id/nextPhoto"
        android:layout_marginTop="4dp"/>

    <ImageButton
        android:id="@+id/likeButton"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginEnd="124dp"
        android:background="@android:color/transparent"
        android:contentDescription="Like"
        android:elevation="8dp"
        android:src="@drawable/ic_like"
        app:layout_constraintBottom_toTopOf="@+id/backButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/nextPhoto"
        app:tint="@android:color/white" />

    <ImageButton
        android:id="@+id/dislikeButton"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:padding="8dp"
        android:layout_marginStart="124dp"
        android:background="@android:color/transparent"
        android:contentDescription="Dislike"
        android:elevation="8dp"
        android:src="@drawable/ic_dislike"
        app:layout_constraintBottom_toTopOf="@+id/backButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/backPhoto"
        app:tint="@android:color/white" />

    <Button
        android:id="@+id/backButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:elevation="8dp"
        android:text="Back"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
